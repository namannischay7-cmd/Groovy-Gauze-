@charset "utf-8";

:root { --bg-color: #f9f9f9; --text-color: #1a1a1a; --accent-color: #333; --font-main: 'Helvetica Neue', Helvetica, Arial, sans-serif; --font-display: 'Courier New', Courier, monospace; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: var(--font-main); background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; overflow-x: hidden; }

a { text-decoration: none; color: inherit; transition: 0.3s; }

ul { list-style: none; }

nav { display: flex; justify-content: space-between; align-items: center; padding: 2rem 5%; background-color: rgb(255, 255, 255); position: sticky; top: 0px; z-index: 100; box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 10px; }

.logo { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; letter-spacing: -1px; text-transform: uppercase; }

.nav-links { display: flex; gap: 2rem; }

.nav-links a { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }

.nav-links a:hover { color: rgb(119, 119, 119); }

.hero { text-align: center; padding: 6rem 1rem; background: rgb(255, 255, 255); margin-bottom: 2rem; }

.hero h1 { font-size: 4rem; line-height: 1.1; margin-bottom: 1rem; font-weight: 800; letter-spacing: -2px; }

.hero p { font-size: 1.2rem; color: rgb(102, 102, 102); max-width: 600px; margin: 0px auto 2rem; }

.btn { display: inline-block; padding: 1rem 2.5rem; background-color: var(--text-color); color: rgb(255, 255, 255); text-transform: uppercase; letter-spacing: 1px; font-size: 0.8rem; font-weight: bold; border: 1px solid var(--text-color); }

.btn:hover { background-color: transparent; color: var(--text-color); }

.container { max-width: 1200px; margin: 0px auto; padding: 0px 1rem; }

.section-title { text-align: center; font-family: var(--font-display); margin-bottom: 3rem; font-size: 1.5rem; color: rgb(85, 85, 85); }

.gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; padding-bottom: 4rem; }

.product-card { background: rgb(255, 255, 255); border-radius: 8px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.03) 0px 5px 15px; transition: transform 0.3s; }

.product-card:hover { transform: translateY(-5px); box-shadow: rgba(0, 0, 0, 0.1) 0px 10px 25px; }

.image-container { width: 100%; height: 400px; overflow: hidden; background-color: rgb(240, 240, 240); display: flex; align-items: center; justify-content: center; }

.product-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }

.product-card:hover img { transform: scale(1.05); }

.product-info { padding: 1.5rem; text-align: center; }

.product-name { font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; text-transform: uppercase; }

footer { background-color: rgb(17, 17, 17); color: rgb(255, 255, 255); padding: 4rem 1rem; text-align: center; }

.footer-content { max-width: 600px; margin: 0px auto; }

.footer-logo { font-family: var(--font-display); font-size: 2rem; margin-bottom: 2rem; display: block; }

.contact-details { margin-bottom: 2rem; font-size: 1.1rem; line-height: 2; }

.contact-buttons { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }

.contact-btn { padding: 1rem 2rem; border-radius: 50px; font-weight: bold; text-transform: uppercase; font-size: 0.9rem; display: flex; align-items: center; gap: 10px; }

.whatsapp-btn { background-color: rgb(37, 211, 102); color: white; }

.insta-btn { background: linear-gradient(45deg, rgb(240, 148, 51) 0%, rgb(230, 104, 60) 25%, rgb(220, 39, 67) 50%, rgb(204, 35, 102) 75%, rgb(188, 24, 136) 100%); color: white; }

.contact-btn:hover { opacity: 0.9; transform: scale(1.02); }

@media (max-width: 768px) {
  .hero h1 { font-size: 2.5rem; }
  .nav-links { display: none; }
  .logo { font-size: 1.5rem; }
  .image-container { height: 350px; }
}
